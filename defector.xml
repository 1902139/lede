name: Update stories

on:
  schedule:
    - cron: "17 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  fetch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install feedparser
      - run: python fetch_news.py
      - name: Stage 2 analysis (skips itself if no API key is set)
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: python analyze.py
      - name: Commit updated data
        run: |
          git config user.name "lede-bot"
          git config user.email "actions@users.noreply.github.com"
          git add stories.json authors.json analysis_cache.json || true
          git diff --cached --quiet || git commit -m "Update stories [skip ci]"
          git push
