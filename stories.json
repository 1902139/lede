name: Update stories

on:
  schedule:
    - cron: "17 * * * *"   # hourly at :17
  workflow_dispatch:        # lets you run it manually from the Actions tab

permissions:
  contents: write

jobs:
  fetch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install feedparser
      - run: python scripts/fetch_news.py
      - name: Stage 2 analysis (skips itself if no API key is set)
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: python scripts/analyze.py
      - name: Commit updated data
        run: |
          git config user.name "lede-bot"
          git config user.email "actions@users.noreply.github.com"
          git add data/stories.json data/analysis_cache.json data/authors.json
          git diff --cached --quiet || git commit -m "Update stories [skip ci]"
          git push
